{
  "manifest_version": 3,
  "name": "Translate Video AI",
  "version": "0.1.0",
  "description": "Transcribe y traduce videos de YouTube con inteligencia artificial.",
  "permissions": [
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*.railway.app/*",
    "https://*.up.railway.app/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
