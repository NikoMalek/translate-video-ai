# Copia este archivo a .env en la raíz del repositorio.

# Modelo de Whisper que se usa cuando la petición no especifica otro.
WHISPER_MODEL=small
# Opcional: "cuda" o "cpu". Si se omite, se detecta automáticamente.
# DEVICE=cuda
# Duración máxima aceptada para un video, en minutos.
MAX_VIDEO_MINUTES=20

# Token de Hugging Face. Es obligatorio: pyannote y el clasificador de género
# se descargan desde Hugging Face y la diarización siempre está activa.
HUGGINGFACE_API_TOKEN=hf_...

# Diarización de hablantes (obligatoria, se precarga al arrancar). El backend
# intenta primero community-1 y, si no puede cargarlo, prueba
# speaker-diarization-3.1.
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1

# Clasificador de género aplicado al audio de cada hablante ya separado.
# Modelo multilingüe XLS-R (~1,2 GB la primera vez).
GENDER_MODEL=alefiury/wav2vec2-large-xlsr-53-gender-recognition-librispeech

# Ajustes avanzados de diarización. Los valores mostrados son los predeterminados.
# Limita el número de hablantes cuando el público o el ruido se detectan como voces.
# PYANNOTE_MIN_SPEAKERS=2
# PYANNOTE_MAX_SPEAKERS=6
# DIARIZATION_MIN_TURN_SECONDS=0.4
# DIARIZATION_RELABEL_MARGIN=0.05
# DIARIZATION_MERGE_GAP=0.4
# DIARIZATION_INHERIT_MAX=2.0
# MIN_SPEAKER_RUN_SECONDS=0.25
# GENDER_MAX_SECONDS=40
# GENDER_WINDOW_SECONDS=5

# Umbral de tono (Hz) del respaldo de seguridad si el clasificador no carga.
VOICE_PITCH_THRESHOLD=155
